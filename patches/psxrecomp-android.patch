         else if (strcmp(text, "21:9")  == 0) { num = 21; den = 9;  }
+        /* The widest view a title's own widescreen code allows: 447:240
+         * (1.8625:1) is a 64 px reveal per side at 320 wide, Digimon World's
+         * DW_MARGIN_MAX. Phones wider than this fill the rest at present. */
+        else if (strcmp(text, "widest") == 0) { num = 447; den = 240; }
         else if (strcmp(text, "4:3")   == 0) { num = 4;  den = 3;  }
     }
     psx_ws_engage_aspect(num, den);
diff --git a/runtime/src/mod_runtime.cpp b/runtime/src/mod_runtime.cpp
index c84f0f9..84bf1ca 100644
--- a/runtime/src/mod_runtime.cpp
+++ b/runtime/src/mod_runtime.cpp
@@ -1154,6 +1154,52 @@ extern "C" const char *mod_runtime_fingerprint_c(void) {
     return mod_runtime_fingerprint().c_str();
 }
 
+/* What a savestate carries over from the mod plan it was taken under: every
+ * byte range a patch rewrote (code and data in guest RAM, and overlay code
+ * loaded from patched disc sectors) plus the plugins that shaped memory. A
+ * restore reapplies the current plan's patches, but ranges only an older plan
+ * patched stay patched, so a state is only clean to load under a plan with the
+ * same ranges and plugins. Option values are left out on purpose: they only
+ * change bytes the current plan rewrites anyway (and aspect-style plugin
+ * options change no RAM at all). */
+extern "C" const char *mod_runtime_state_fingerprint_c(void) {
+    using namespace PSXRecompV4;
+    static std::string cached;
+    RuntimeMods& s = state();
+    if (!s.initialized || !s.plan.ok) return "none";
+    if (cached.empty()) {
+        uint64_t h = 1469598103934665603ull;   /* FNV-1a */
+        auto mix = [&h](const void* p, size_t n) {
+            const uint8_t* b = static_cast<const uint8_t*>(p);
+            for (size_t i = 0; i < n; ++i) { h ^= b[i]; h *= 1099511628211ull; }
+        };
+        std::vector<std::string> ranges;
+        for (const ModResolution::Write& w : s.plan.writes) {
+            char buf[64];
+            if (w.fields.empty()) {
+                std::snprintf(buf, sizeof(buf), "%d:%llx+%zu", (int)w.target,
+                              (unsigned long long)w.location, w.replacement.size());
+                ranges.push_back(buf);
+            }
+            for (const ModResolution::Write::Field& f : w.fields) {
+                std::snprintf(buf, sizeof(buf), "%d:%llx+%zu", (int)w.target,
+                              (unsigned long long)(w.location + f.offset),
+                              f.replacement.size());
+                ranges.push_back(buf);
+            }
+        }
+        for (const ModResolution::Plugin& plugin : s.plan.plugins)
+            ranges.push_back("plugin:" + plugin.id);
+        std::sort(ranges.begin(), ranges.end());
+        ranges.erase(std::unique(ranges.begin(), ranges.end()), ranges.end());
+        for (const std::string& r : ranges) mix(r.c_str(), r.size() + 1);
+        char out[24];
+        std::snprintf(out, sizeof(out), "%016llx", (unsigned long long)h);
+        cached = out;
+    }
+    return cached.c_str();
+}
+
 const std::filesystem::path& mod_runtime_effective_disc_path() {
     return state().effective_disc_path;
 }
diff --git a/runtime/src/psx_android.cpp b/runtime/src/psx_android.cpp
new file mode 100644
index 0000000..cbc54a6
--- /dev/null
+++ b/runtime/src/psx_android.cpp
@@ -0,0 +1,329 @@
+/*
+ * psx_android.cpp — Android host glue, run from the top of main().
+ *
+ * On desktop every runtime file (game.toml, disc, BIOS, mods, saves) is found
+ * next to the executable. An Android app has no executable directory, so this
+ * gives it one: the app's external files directory
+ * (/storage/emulated/0/Android/data/<package>/files, which needs no storage
+ * permission and is reachable over USB for save backups), falling back to
+ * internal storage. The app's setup screen (Java) installs the support files
+ * there and imports the player's disc; argv[0] is pointed into that directory
+ * so exe_dir_from_argv() anchors there.
+ *
+ * The same library also serves the setup screen: psx_translate_disc() turns
+ * the player's disc into C (see the JNI entry points at the bottom), which the
+ * runtime compiles at every launch (psx_dynamic_game.c).
+ *
+ * stdout/stderr (where the runtime logs everything) go to logcat under the
+ * tag "DigimonWorld" and to log.txt in the data directory.
+ */
+#include "psx_android.h"
+
+#if defined(__ANDROID__)
+
+#include <SDL3/SDL.h>
+#include <android/log.h>
+
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace {
+
+const char* const kLogTag = "DigimonWorld";
+
+std::string g_data_dir;
+std::vector<std::string> g_args;
+std::vector<char*> g_argv;
+int g_log_fd = -1;
+
+void alog(const char* fmt, ...) __attribute__((format(printf, 1, 2)));
+void alog(const char* fmt, ...) {
+    va_list ap;
+    va_start(ap, fmt);
+    __android_log_vprint(ANDROID_LOG_INFO, kLogTag, fmt, ap);
+    va_end(ap);
+}
+
+/* Pump the stdout/stderr pipe into logcat and log.txt, one line at a time. */
+void* log_pump(void* arg) {
+    const int fd = (int)(intptr_t)arg;
+    char buf[4096];
+    std::string line;
+    for (;;) {
+        const ssize_t n = read(fd, buf, sizeof(buf));
+        if (n <= 0) {
+            if (n < 0 && errno == EINTR) continue;
+            break;
+        }
+        if (g_log_fd >= 0) (void)!write(g_log_fd, buf, (size_t)n);
+        for (ssize_t i = 0; i < n; i++) {
+            if (buf[i] == '\n') {
+                __android_log_write(ANDROID_LOG_INFO, kLogTag, line.c_str());
+                line.clear();
+            } else {
+                line.push_back(buf[i]);
+            }
+        }
+    }
+    return nullptr;
+}
+
+void redirect_stdio_to_log() {
+    /* Once per process: the setup screen and the game share the process. */
+    static bool s_done = false;
+    if (s_done) return;
+    s_done = true;
+    const std::string log_path = g_data_dir + "/log.txt";
+    g_log_fd = open(log_path.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+    int fds[2];
+    if (pipe(fds) != 0) return;
+    setvbuf(stdout, nullptr, _IOLBF, 0);
+    setvbuf(stderr, nullptr, _IOLBF, 0);
+    dup2(fds[1], STDOUT_FILENO);
+    dup2(fds[1], STDERR_FILENO);
+    close(fds[1]);
+    pthread_t t;
+    if (pthread_create(&t, nullptr, log_pump, (void*)(intptr_t)fds[0]) == 0)
+        pthread_detach(t);
+}
+
+bool is_dir(const std::string& p) {
+    struct stat st;
+    return stat(p.c_str(), &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+bool make_dirs(const std::string& path) {
+    std::string cur;
+    size_t pos = 0;
+    while (pos != std::string::npos) {
+        pos = path.find('/', pos + 1);
+        cur = path.substr(0, pos);
+        if (cur.empty() || is_dir(cur)) continue;
+        if (mkdir(cur.c_str(), 0755) != 0 && errno != EEXIST) return false;
+    }
+    return true;
+}
+
+}  // namespace
+
+extern "C" void psx_android_bootstrap(int* argc, char*** argv) {
+    const char* base = nullptr;
+    if (SDL_GetAndroidExternalStorageState() & SDL_ANDROID_EXTERNAL_STORAGE_WRITE)
+        base = SDL_GetAndroidExternalStoragePath();
+    if (!base || !*base) base = SDL_GetAndroidInternalStoragePath();
+    g_data_dir = base ? base : ".";
+    make_dirs(g_data_dir);
+    redirect_stdio_to_log();
+    alog("data directory: %s", g_data_dir.c_str());
+    if (chdir(g_data_dir.c_str()) != 0)
+        alog("chdir(%s) failed: %s", g_data_dir.c_str(), strerror(errno));
+
+    /* Landscape only, and keep Android's Back from closing the game when a
+     * controller (or the gesture bar) sends it. */
+    SDL_SetHint(SDL_HINT_ORIENTATIONS, "LandscapeLeft LandscapeRight");
+    SDL_SetHint(SDL_HINT_ANDROID_TRAP_BACK_BUTTON, "1");
+
+    /* Controllers. Phones expose keypads and remotes with D-pad keys that SDL
+     * would otherwise list as game controllers, and player 1 could claim one
+     * of those before the real pad connects over Bluetooth. Ignore devices
+     * with no sticks or hat, and let player 1 read every connected controller
+     * (the runtime's PSX_DEV_INPUT merge), so whichever pad is connected, and
+     * whenever, simply works. This is a single-player game, so there is no
+     * second player to steal input from. */
+    SDL_SetHint(SDL_HINT_TV_REMOTE_AS_JOYSTICK, "0");
+    setenv("PSX_DEV_INPUT", "1", 0);
+
+    /* The debug-build starvation watchdog aborts after a few seconds without
+     * a frame. A phone app legitimately stops for much longer (backgrounded,
+     * save-state menu open), so it has no meaning here. */
+    setenv("PSX_STARVATION_TIMEOUT_US", "0", 0);
+
+    /* argv[0] is the anchor for every runtime path, so place it in the data
+     * directory. Boot straight into the game: the desktop launcher is not
+     * built for Android. Arguments from the activity follow. */
+    g_args.clear();
+    g_args.push_back(g_data_dir + "/Digimon_World_Recompiled");
+    g_args.push_back("--no-launcher");
+    for (int i = 1; i < *argc; i++) g_args.push_back((*argv)[i]);
+    g_argv.clear();
+    for (auto& a : g_args) g_argv.push_back(a.data());
+    g_argv.push_back(nullptr);
+    *argc = (int)g_args.size();
+    *argv = g_argv.data();
+}
+
+extern "C" const char* psx_android_data_dir(void) { return g_data_dir.c_str(); }
+
+namespace {
+/* Log controller arrivals/departures so a pad that is not picked up can be
+ * diagnosed from logcat (or log.txt) alone. */
+bool SDLCALL log_device_events(void*, SDL_Event* ev) {
+    switch (ev->type) {
+    case SDL_EVENT_JOYSTICK_ADDED: {
+        const SDL_JoystickID id = ev->jdevice.which;
+        const char* name = SDL_GetJoystickNameForID(id);
+        alog("input: joystick added: id=%d name=\"%s\" vid=%04x pid=%04x gamepad=%d",
+             (int)id, name ? name : "?", SDL_GetJoystickVendorForID(id),
+             SDL_GetJoystickProductForID(id), SDL_IsGamepad(id) ? 1 : 0);
+        break;
+    }
+    case SDL_EVENT_JOYSTICK_REMOVED:
+        alog("input: joystick removed: id=%d", (int)ev->jdevice.which);
+        break;
+    case SDL_EVENT_GAMEPAD_ADDED:
+        alog("input: gamepad added: id=%d", (int)ev->gdevice.which);
+        break;
+    default:
+        break;
+    }
+    return true;
+}
+}  // namespace
+
+extern "C" void psx_android_after_sdl_init(void) {
+    SDL_AddEventWatch(log_device_events, nullptr);
+    int count = 0;
+    SDL_JoystickID* ids = SDL_GetJoysticks(&count);
+    alog("input: %d joystick(s) at startup", count);
+    for (int i = 0; ids && i < count; i++) {
+        const char* name = SDL_GetJoystickNameForID(ids[i]);
+        alog("input:   id=%d name=\"%s\" gamepad=%d", (int)ids[i], name ? name : "?",
+             SDL_IsGamepad(ids[i]) ? 1 : 0);
+    }
+    SDL_free(ids);
+}
+
+namespace {
+struct MainCall {
+    int (*fn)(int, char**);
+    int argc;
+    char** argv;
+    int rc;
+};
+
+void* main_thread(void* arg) {
+    MainCall* call = (MainCall*)arg;
+    call->rc = call->fn(call->argc, call->argv);
+    return nullptr;
+}
+}  // namespace
+
+extern "C" int psx_android_main(int (*fn)(int, char**), int argc, char** argv) {
+    psx_android_bootstrap(&argc, &argv);
+    /* Same stack the Windows build links with (-Wl,--stack,67108864). Only
+     * the pages actually touched are ever committed. */
+    MainCall call = {fn, argc, argv, 1};
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setstacksize(&attr, 64u << 20);
+    pthread_t t;
+    const int err = pthread_create(&t, &attr, main_thread, &call);
+    pthread_attr_destroy(&attr);
+    if (err != 0) {
+        alog("pthread_create for the runtime thread failed (%d); running inline", err);
+        return fn(argc, argv);
+    }
+    pthread_join(t, nullptr);
+    return call.rc;
+}
+
+/* ---- app lifecycle requests from the in-game menu ------------------------- */
+
+#include <jni.h>
+
+namespace {
+/* Call a no-argument method on the running activity (DigimonActivity). */
+void call_activity(const char* method) {
+    JNIEnv* env = (JNIEnv*)SDL_GetAndroidJNIEnv();
+    jobject activity = (jobject)SDL_GetAndroidActivity();
+    if (!env || !activity) return;
+    jclass cls = env->GetObjectClass(activity);
+    jmethodID m = env->GetMethodID(cls, method, "()V");
+    if (m) env->CallVoidMethod(activity, m);
+    if (env->ExceptionCheck()) env->ExceptionClear();
+    env->DeleteLocalRef(cls);
+    env->DeleteLocalRef(activity);
+}
+
+[[noreturn]] void wait_for_exit() {
+    /* The activity ends the process; never return into the game loop. */
+    for (;;) SDL_Delay(1000);
+}
+}  // namespace
+
+/* Start over through the setup screen (after "Change disc" or a setting that
+ * applies at boot). Saves must already be flushed. */
+extern "C" void psx_android_restart_app(void) {
+    alog("restarting the app");
+    call_activity("restartApp");
+    wait_for_exit();
+}
+
+extern "C" void psx_android_quit_app(void) {
+    alog("quitting");
+    call_activity("quitApp");
+    wait_for_exit();
+}
+
+/* ---- setup screen (com.cogent.digimonworld.SetupActivity) ---------------- */
+#if defined(PSX_DYNAMIC_GAME)
+
+#include "psx_translate.h"
+
+namespace {
+std::string jstr(JNIEnv* env, jstring s) {
+    if (!s) return {};
+    const char* c = env->GetStringUTFChars(s, nullptr);
+    std::string out = c ? c : "";
+    if (c) env->ReleaseStringUTFChars(s, c);
+    return out;
+}
+}  // namespace
+
+/* Returns null on success, or a message for the player. */
+extern "C" JNIEXPORT jstring JNICALL
+Java_com_cogent_digimonworld_SetupActivity_nativeTranslate(
+        JNIEnv* env, jclass, jstring data_dir, jstring disc_path, jstring exe_sha256) {
+    /* One translation at a time: two would write the same files (and the
+     * recompiler keeps global state). A second caller waits, then finds the
+     * work done. */
+    static std::mutex s_translate_mutex;
+    std::lock_guard<std::mutex> lock(s_translate_mutex);
+    g_data_dir = jstr(env, data_dir);
+    redirect_stdio_to_log();
+    const std::string disc = jstr(env, disc_path);
+    const std::string sha = jstr(env, exe_sha256);
+    if (psx_translate_is_current(g_data_dir.c_str(), sha.c_str())) {
+        alog("setup: already translated");
+        return nullptr;
+    }
+    alog("setup: translating %s", disc.c_str());
+    char err[1024] = {0};
+    const int rc = psx_translate_disc(g_data_dir.c_str(), disc.c_str(), sha.c_str(),
+                                      err, sizeof(err));
+    alog("setup: translation %s%s%s", rc == 0 ? "complete" : "failed: ",
+         rc == 0 ? "" : err, "");
+    return rc == 0 ? nullptr : env->NewStringUTF(err);
+}
+
+extern "C" JNIEXPORT jboolean JNICALL
+Java_com_cogent_digimonworld_SetupActivity_nativeIsTranslated(
+        JNIEnv* env, jclass, jstring data_dir, jstring exe_sha256) {
+    const std::string dir = jstr(env, data_dir);
+    const std::string sha = jstr(env, exe_sha256);
+    return psx_translate_is_current(dir.c_str(), sha.c_str()) ? JNI_TRUE : JNI_FALSE;
+}
+
+#endif /* PSX_DYNAMIC_GAME */
+#endif /* __ANDROID__ */
diff --git a/runtime/src/psx_dynamic_game.c b/runtime/src/psx_dynamic_game.c
new file mode 100644
index 0000000..b91368d
--- /dev/null
+++ b/runtime/src/psx_dynamic_game.c
@@ -0,0 +1,293 @@
+/*
+ * psx_dynamic_game.c — load the recompiled game at startup instead of linking
+ * it at build time.
+ *
+ * A PSX_DYNAMIC_GAME build carries no game code at all. The recompiler's output
+ * for the player's own disc (generated/*.c) is compiled into memory with
+ * libtcc when the runtime starts, and the five entry points the runtime calls
+ * into game code are bound to it. The build still defines
+ * PSX_HAS_GAME_DISPATCH, so every other part of the runtime behaves exactly as
+ * in a build that linked the same C statically.
+ *
+ * Until the load succeeds (and if it fails) every query answers "not
+ * compiled", which routes execution through the interpreter exactly like any
+ * code the recompiler did not cover.
+ */
+#include "psx_dynamic_game.h"
+
+#include <dirent.h>
+#include <stdarg.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#include "libtcc.h"
+
+#ifndef PSX_DYNAMIC_GAME_CFLAGS
+#  define PSX_DYNAMIC_GAME_CFLAGS ""
+#endif
+
+typedef struct CPUState CPUState;
+
+static int (*s_address_in_text)(uint32_t addr);
+static int (*s_text_native_ok)(uint32_t addr);
+static int (*s_text_native_ok_full)(uint32_t addr);
+static int (*s_dispatch)(CPUState *cpu, uint32_t addr);
+static int (*s_is_entry)(uint32_t addr);
+static TCCState *s_tcc;   /* owns the compiled code for the process lifetime */
+
+int psx_game_address_in_text(uint32_t addr)
+{
+    return s_address_in_text ? s_address_in_text(addr) : 0;
+}
+
+int psx_game_text_native_ok(uint32_t addr)
+{
+    return s_text_native_ok ? s_text_native_ok(addr) : 0;
+}
+
+int psx_game_text_native_ok_full(uint32_t addr)
+{
+    return s_text_native_ok_full ? s_text_native_ok_full(addr) : 0;
+}
+
+int psx_dispatch_game_compiled(CPUState *cpu, uint32_t addr)
+{
+    return s_dispatch ? s_dispatch(cpu, addr) : 0;
+}
+
+int psx_game_is_function_entry(uint32_t addr)
+{
+    return s_is_entry ? s_is_entry(addr) : 0;
+}
+
+int psx_dynamic_game_loaded(void)
+{
+    return s_dispatch != NULL;
+}
+
+/* The generated dispatcher marks CPS mode from a static constructor that
+ * runs before main(); do the same here so nothing that reads the flag early
+ * sees a different mode than a statically linked build would. */
+__attribute__((constructor)) static void psx_dynamic_game_mark_cps(void)
+{
+    extern int g_psx_cps_mode;
+    g_psx_cps_mode = 1;
+}
+
+/* The generated dispatcher defines the same five names as the forwarders
+ * above; compile it with its copies renamed. */
+static const char *const k_entry_points[][2] = {
+    { "psx_game_address_in_text",     "psx_dyn_game_address_in_text" },
+    { "psx_game_text_native_ok",      "psx_dyn_game_text_native_ok" },
+    { "psx_game_text_native_ok_full", "psx_dyn_game_text_native_ok_full" },
+    { "psx_dispatch_game_compiled",   "psx_dyn_dispatch_game_compiled" },
+    { "psx_game_is_function_entry",   "psx_dyn_game_is_function_entry" },
+};
+
+/* TinyCC lowers the bit-scan builtins to calls into its own helper library
+ * (libtcc1), which a -nostdlib memory compile does not link. Supply them from
+ * the host compiler instead, which implements them natively. */
+static int h_ffs(int x) { return __builtin_ffs(x); }
+static int h_ffsl(long x) { return __builtin_ffsl(x); }
+static int h_ffsll(long long x) { return __builtin_ffsll(x); }
+static int h_clz(unsigned x) { return __builtin_clz(x); }
+static int h_clzl(unsigned long x) { return __builtin_clzl(x); }
+static int h_clzll(unsigned long long x) { return __builtin_clzll(x); }
+static int h_ctz(unsigned x) { return __builtin_ctz(x); }
+static int h_ctzl(unsigned long x) { return __builtin_ctzl(x); }
+static int h_ctzll(unsigned long long x) { return __builtin_ctzll(x); }
+static int h_clrsb(int x) { return __builtin_clrsb(x); }
+static int h_clrsbl(long x) { return __builtin_clrsbl(x); }
+static int h_clrsbll(long long x) { return __builtin_clrsbll(x); }
+static int h_popcount(unsigned x) { return __builtin_popcount(x); }
+static int h_popcountl(unsigned long x) { return __builtin_popcountl(x); }
+static int h_popcountll(unsigned long long x) { return __builtin_popcountll(x); }
+static int h_parity(unsigned x) { return __builtin_parity(x); }
+static int h_parityl(unsigned long x) { return __builtin_parityl(x); }
+static int h_parityll(unsigned long long x) { return __builtin_parityll(x); }
+
+static const struct { const char *name; const void *fn; } k_tcc_builtins[] = {
+    { "__builtin_ffs", (const void *)h_ffs },
+    { "__builtin_ffsl", (const void *)h_ffsl },
+    { "__builtin_ffsll", (const void *)h_ffsll },
+    { "__builtin_clz", (const void *)h_clz },
+    { "__builtin_clzl", (const void *)h_clzl },
+    { "__builtin_clzll", (const void *)h_clzll },
+    { "__builtin_ctz", (const void *)h_ctz },
+    { "__builtin_ctzl", (const void *)h_ctzl },
+    { "__builtin_ctzll", (const void *)h_ctzll },
+    { "__builtin_clrsb", (const void *)h_clrsb },
+    { "__builtin_clrsbl", (const void *)h_clrsbl },
+    { "__builtin_clrsbll", (const void *)h_clrsbll },
+    { "__builtin_popcount", (const void *)h_popcount },
+    { "__builtin_popcountl", (const void *)h_popcountl },
+    { "__builtin_popcountll", (const void *)h_popcountll },
+    { "__builtin_parity", (const void *)h_parity },
+    { "__builtin_parityl", (const void *)h_parityl },
+    { "__builtin_parityll", (const void *)h_parityll },
+};
+
+typedef struct {
+    char  *buf;
+    size_t len;
+} ErrBuf;
+
+static void err_printf(ErrBuf *e, const char *fmt, ...)
+{
+    if (!e->buf || e->len == 0) return;
+    size_t used = strlen(e->buf);
+    if (used + 1 >= e->len) return;
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(e->buf + used, e->len - used, fmt, ap);
+    va_end(ap);
+}
+
+static void collect_tcc_error(void *opaque, const char *msg)
+{
+    ErrBuf *e = (ErrBuf *)opaque;
+    /* Keep the first few messages; one compile error tends to cascade. */
+    if (e->buf && strlen(e->buf) < e->len / 2)
+        err_printf(e, "%s\n", msg);
+}
+
+static int is_dir(const char *path)
+{
+    struct stat st;
+    return stat(path, &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+static int cmp_names(const void *a, const void *b)
+{
+    return strcmp(*(const char *const *)a, *(const char *const *)b);
+}
+
+/* The translation units psxrecomp-game writes: *_full_NN.c shards (or a
+ * single *_full.c) plus *_dispatch.c. Sorted so the load is deterministic. */
+static int list_game_sources(const char *gen_dir, char ***out)
+{
+    DIR *d = opendir(gen_dir);
+    if (!d) return -1;
+    int cap = 64, n = 0;
+    char **names = (char **)malloc(sizeof(char *) * (size_t)cap);
+    struct dirent *de;
+    while (names && (de = readdir(d)) != NULL) {
+        const char *nm = de->d_name;
+        size_t l = strlen(nm);
+        if (l < 3 || strcmp(nm + l - 2, ".c") != 0) continue;
+        if (!strstr(nm, "_full") && !strstr(nm, "_dispatch.c")) continue;
+        if (n == cap) {
+            cap *= 2;
+            char **grown = (char **)realloc(names, sizeof(char *) * (size_t)cap);
+            if (!grown) break;
+            names = grown;
+        }
+        names[n++] = strdup(nm);
+    }
+    closedir(d);
+    if (!names) return -1;
+    qsort(names, (size_t)n, sizeof(char *), cmp_names);
+    *out = names;
+    return n;
+}
+
+int psx_dynamic_game_load(const char *gen_dir, const char *tcc_dir,
+                          char *err, size_t err_len)
+{
+    ErrBuf e = { err, err_len };
+    if (err && err_len) err[0] = '\0';
+    if (s_tcc) return 0;
+    if (!gen_dir || !is_dir(gen_dir)) {
+        err_printf(&e, "no translated game in %s", gen_dir ? gen_dir : "(null)");
+        return -1;
+    }
+
+    char **names = NULL;
+    const int count = list_game_sources(gen_dir, &names);
+    if (count <= 0) {
+        err_printf(&e, "no recompiled C in %s", gen_dir);
+        free(names);
+        return -1;
+    }
+
+    TCCState *s = tcc_new();
+    if (!s) {
+        err_printf(&e, "tcc_new failed");
+        return -1;
+    }
+    tcc_set_error_func(s, &e, collect_tcc_error);
+    tcc_set_lib_path(s, tcc_dir);
+    /* Headers come only from tcc_dir (no host sysroot is assumed), and
+     * nothing is linked in: every external the translation references lives
+     * in this process and is resolved with dlsym at relocation time. */
+    tcc_set_options(s, "-nostdinc -nostdlib " PSX_DYNAMIC_GAME_CFLAGS);
+    tcc_set_output_type(s, TCC_OUTPUT_MEMORY);
+
+    char path[1024];
+    static const char *const k_inc[] = { "include", "psx", "libc" };
+    for (size_t i = 0; i < sizeof(k_inc) / sizeof(k_inc[0]); i++) {
+        snprintf(path, sizeof(path), "%s/%s", tcc_dir, k_inc[i]);
+        if (is_dir(path)) tcc_add_sysinclude_path(s, path);
+    }
+    /* Without the minimal libc headers (tcc_dir/libc, staged for Android),
+     * take stdint.h / stdio.h / string.h from the host system. */
+    snprintf(path, sizeof(path), "%s/libc", tcc_dir);
+    if (!is_dir(path)) {
+        tcc_add_sysinclude_path(s, "/usr/include");
+#if defined(__x86_64__)
+        tcc_add_sysinclude_path(s, "/usr/include/x86_64-linux-gnu");
+#elif defined(__aarch64__)
+        tcc_add_sysinclude_path(s, "/usr/include/aarch64-linux-gnu");
+#endif
+    }
+    tcc_add_include_path(s, gen_dir);
+    for (size_t i = 0; i < sizeof(k_entry_points) / sizeof(k_entry_points[0]); i++)
+        tcc_define_symbol(s, k_entry_points[i][0], k_entry_points[i][1]);
+    for (size_t i = 0; i < sizeof(k_tcc_builtins) / sizeof(k_tcc_builtins[0]); i++)
+        tcc_add_symbol(s, k_tcc_builtins[i].name, k_tcc_builtins[i].fn);
+
+    int rc = 0;
+    for (int i = 0; i < count && rc == 0; i++) {
+        snprintf(path, sizeof(path), "%s/%s", gen_dir, names[i]);
+        if (tcc_add_file(s, path) < 0) {
+            err_printf(&e, "while compiling %s\n", names[i]);
+            rc = -1;
+        }
+    }
+    for (int i = 0; i < count; i++) free(names[i]);
+    free(names);
+
+    if (rc == 0 && tcc_relocate(s) < 0) {
+        err_printf(&e, "relocation failed\n");
+        rc = -1;
+    }
+    if (rc == 0) {
+        void *sym[5];
+        for (size_t i = 0; i < 5; i++) {
+            sym[i] = tcc_get_symbol(s, k_entry_points[i][1]);
+            if (!sym[i]) {
+                err_printf(&e, "translation has no %s\n", k_entry_points[i][0]);
+                rc = -1;
+            }
+        }
+        if (rc == 0) {
+            s_address_in_text     = (int (*)(uint32_t))sym[0];
+            s_text_native_ok      = (int (*)(uint32_t))sym[1];
+            s_text_native_ok_full = (int (*)(uint32_t))sym[2];
+            s_dispatch            = (int (*)(CPUState *, uint32_t))sym[3];
+            s_is_entry            = (int (*)(uint32_t))sym[4];
+        }
+    }
+    if (rc != 0) {
+        tcc_delete(s);
+        return -1;
+    }
+    s_tcc = s;
+    fprintf(stdout, "psxrecomp: loaded the translated game (%d source files) from %s\n",
+            count, gen_dir);
+    fflush(stdout);
+    return 0;
+}
diff --git a/runtime/src/psx_fiber.c b/runtime/src/psx_fiber.c
index a379eca..65cb1dd 100644
--- a/runtime/src/psx_fiber.c
+++ b/runtime/src/psx_fiber.c
@@ -34,6 +34,197 @@ psx_fiber_t psx_fiber_create(size_t stack_size, psx_fiber_entry entry, void* arg
 void psx_fiber_switch(psx_fiber_t target) { SwitchToFiber((LPVOID)target); }
