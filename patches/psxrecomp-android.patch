diff --git a/tools/stage_tcc_headers.py b/tools/stage_tcc_headers.py
new file mode 100644
index 0000000..6b4a76d
--- /dev/null
+++ b/tools/stage_tcc_headers.py
@@ -0,0 +1,52 @@
+#!/usr/bin/env python3
+"""Stage the headers a PSX_DYNAMIC_GAME runtime compiles the translated game
+against (see runtime/src/psx_dynamic_game.c):
+
+    <out>/include  TinyCC's own headers (stddef.h, stdarg.h, ...)
+    <out>/psx      the runtime headers the generated C includes
+    <out>/libc     minimal libc headers (only with --libc; for Android, which
+                   has no system headers on the device)
+
+Runtime headers are copied with any UTF-8 byte-order mark removed."""
+import argparse
+import os
+import shutil
+
+
+def copy_headers(src, dst):
+    os.makedirs(dst, exist_ok=True)
+    for name in sorted(os.listdir(src)):
+        if not name.endswith(".h"):
+            continue
+        with open(os.path.join(src, name), "rb") as f:
+            data = f.read()
+        if data.startswith(b"\xef\xbb\xbf"):
+            data = data[3:]
+        out = os.path.join(dst, name)
+        try:
+            with open(out, "rb") as f:
+                if f.read() == data:
+                    continue
+        except OSError:
+            pass
+        with open(out, "wb") as f:
+            f.write(data)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--tinycc", required=True, help="tinycc source tree")
+    ap.add_argument("--runtime-include", required=True)
+    ap.add_argument("--libc", default="", help="minimal libc header dir")
+    ap.add_argument("--out", required=True)
+    a = ap.parse_args()
+    copy_headers(os.path.join(a.tinycc, "include"), os.path.join(a.out, "include"))
+    copy_headers(a.runtime_include, os.path.join(a.out, "psx"))
+    if a.libc:
+        copy_headers(a.libc, os.path.join(a.out, "libc"))
+    elif os.path.isdir(os.path.join(a.out, "libc")):
+        shutil.rmtree(os.path.join(a.out, "libc"))
+
+
+if __name__ == "__main__":
+    main()
