diff --git a/runtime/include/psx_android.h b/runtime/include/psx_android.h
new file mode 100644
index 0000000..a233bc8
--- /dev/null
+++ b/runtime/include/psx_android.h
@@ -0,0 +1,32 @@
+/*
+ * psx_android.h — Android host glue (see psx_android.cpp).
+ */
+#ifndef PSX_ANDROID_H
+#define PSX_ANDROID_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#if defined(__ANDROID__)
+/* Pick the data directory, route stdout/stderr to logcat + log.txt, unpack the
+ * APK payload, and rewrite argv so argv[0] anchors inside the data directory. */
+void psx_android_bootstrap(int* argc, char*** argv);
+
+/* SDL_main body: psx_android_bootstrap(), then fn(argc, argv) on a thread with
+ * a desktop-sized (64 MB) stack. Returns fn's result. */
+int psx_android_main(int (*fn)(int, char**), int argc, char** argv);
+
+/* Called right after SDL_Init: logs connected controllers and installs an
+ * event watch that logs controller hotplug. */
+void psx_android_after_sdl_init(void);
+
+/* The directory chosen by psx_android_bootstrap(). */
+const char* psx_android_data_dir(void);
+#endif
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PSX_ANDROID_H */
diff --git a/runtime/include/psx_dynamic_game.h b/runtime/include/psx_dynamic_game.h
new file mode 100644
index 0000000..741868c
--- /dev/null
+++ b/runtime/include/psx_dynamic_game.h
@@ -0,0 +1,35 @@
+/*
+ * psx_dynamic_game.h — load the recompiled game at startup (see
+ * psx_dynamic_game.c).
+ */
+#ifndef PSX_DYNAMIC_GAME_H
+#define PSX_DYNAMIC_GAME_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Compile the recompiler's output in gen_dir (<exe>_full_*.c and
+ * <exe>_dispatch.c, as psxrecomp-game writes them) into memory and bind the
+ * runtime's game-dispatch entry points to it.
+ *
+ * tcc_dir holds the headers the translation is compiled against:
+ *   tcc_dir/include  TinyCC's own headers (stddef.h, stdarg.h, ...)
+ *   tcc_dir/psx      the runtime headers the generated C includes
+ *   tcc_dir/libc     minimal libc headers, for hosts without system headers
+ *
+ * Returns 0 on success. On failure returns -1 with a message in err, and the
+ * runtime keeps running everything through the interpreter. */
+int psx_dynamic_game_load(const char *gen_dir, const char *tcc_dir,
+                          char *err, size_t err_len);
+
+/* 1 once psx_dynamic_game_load() has succeeded. */
+int psx_dynamic_game_loaded(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PSX_DYNAMIC_GAME_H */
diff --git a/runtime/include/psx_translate.h b/runtime/include/psx_translate.h
new file mode 100644
index 0000000..4eab9d6
--- /dev/null
+++ b/runtime/include/psx_translate.h
@@ -0,0 +1,30 @@
+/*
+ * psx_translate.h — translate the player's disc into C in-process (see
+ * psx_translate.cpp). PSX_DYNAMIC_GAME builds only.
+ */
+#ifndef PSX_TRANSLATE_H
+#define PSX_TRANSLATE_H
+
+#include <stddef.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Extract the boot executable from disc_path (.cue/.bin/.chd), check its
+ * SHA-256 against expect_exe_sha256 (skipped when NULL/empty), and run the
+ * recompiler with data_dir/game.toml, writing data_dir/generated/.
+ * Returns 0 on success, -2 for a disc with the wrong program, -1 otherwise;
+ * err receives a message suitable for the player. */
+int psx_translate_disc(const char *data_dir, const char *disc_path,
+                       const char *expect_exe_sha256, char *err, size_t err_len);
+
+/* 1 if data_dir/generated holds a translation of that executable made by
+ * this build's recompiler. */
+int psx_translate_is_current(const char *data_dir, const char *expect_exe_sha256);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* PSX_TRANSLATE_H */
