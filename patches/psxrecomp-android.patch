+#elif defined(__ANDROID__) && (defined(__aarch64__) || defined(__x86_64__))
+
+/* Android: bionic has no getcontext/makecontext/swapcontext, so switch stacks
+ * with a small hand-written routine instead. Every switch is an ordinary C
+ * call into psx_fiber_ctx_switch, so only the callee-saved registers have to
+ * be preserved: they are pushed onto the outgoing stack, the stack pointer is
+ * stored in the outgoing fiber, and the incoming fiber's stack is popped. */
+
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+
+typedef struct psx_fiber_impl {
+    void*           sp;       /* saved stack pointer while suspended */
+    void*           stack;    /* NULL for the thread-fiber */
+    psx_fiber_entry entry;
+    void*           arg;
+} psx_fiber_impl;
+
+/* Cooperative + single-threaded, so a plain static tracks who's running. */
+static psx_fiber_impl* s_current = NULL;
+
+void psx_fiber_ctx_switch(void** save_sp, void* load_sp)
+    __attribute__((visibility("hidden")));
+void psx_fiber_ctx_start(void) __attribute__((visibility("hidden")));
+
+/* First C frame of a new fiber; psx_fiber_ctx_start passes the fiber in. */
+__attribute__((visibility("hidden"), used, noreturn))
+void psx_fiber_run_entry(psx_fiber_impl* f)
+{
+    f->entry(f->arg);
+    /* The BIOS thread entry never returns normally (it switches back to its
+     * scheduler target, or trap_crashes). Reaching here is a bug. */
+    abort();
+}
+
+#if defined(__aarch64__)
+/* Frame: x19-x28, x29/x30, d8-d15 = 20 slots, 160 bytes (16-aligned). */
+#define PSX_FIBER_FRAME_BYTES 160
+#define PSX_FIBER_ARG_SLOT    0    /* x19 carries the fiber into ctx_start */
+#define PSX_FIBER_FP_SLOT     10   /* x29 */
+#define PSX_FIBER_RET_SLOT    11   /* x30 */
+__asm__(
+    ".text\n"
+    ".p2align 2\n"
+    ".global psx_fiber_ctx_switch\n"
+    ".hidden psx_fiber_ctx_switch\n"
+    ".type psx_fiber_ctx_switch, %function\n"
+    "psx_fiber_ctx_switch:\n"
+    "    sub  sp, sp, #160\n"
+    "    stp  x19, x20, [sp, #0]\n"
+    "    stp  x21, x22, [sp, #16]\n"
+    "    stp  x23, x24, [sp, #32]\n"
+    "    stp  x25, x26, [sp, #48]\n"
+    "    stp  x27, x28, [sp, #64]\n"
+    "    stp  x29, x30, [sp, #80]\n"
+    "    stp  d8,  d9,  [sp, #96]\n"
+    "    stp  d10, d11, [sp, #112]\n"
+    "    stp  d12, d13, [sp, #128]\n"
+    "    stp  d14, d15, [sp, #144]\n"
+    "    mov  x9, sp\n"
+    "    str  x9, [x0]\n"
+    "    mov  sp, x1\n"
+    "    ldp  x19, x20, [sp, #0]\n"
+    "    ldp  x21, x22, [sp, #16]\n"
+    "    ldp  x23, x24, [sp, #32]\n"
+    "    ldp  x25, x26, [sp, #48]\n"
+    "    ldp  x27, x28, [sp, #64]\n"
+    "    ldp  x29, x30, [sp, #80]\n"
+    "    ldp  d8,  d9,  [sp, #96]\n"
+    "    ldp  d10, d11, [sp, #112]\n"
+    "    ldp  d12, d13, [sp, #128]\n"
+    "    ldp  d14, d15, [sp, #144]\n"
+    "    add  sp, sp, #160\n"
+    "    ret\n"
+    ".size psx_fiber_ctx_switch, .-psx_fiber_ctx_switch\n"
+    ".p2align 2\n"
+    ".global psx_fiber_ctx_start\n"
+    ".hidden psx_fiber_ctx_start\n"
+    ".type psx_fiber_ctx_start, %function\n"
+    "psx_fiber_ctx_start:\n"
+    "    mov  x0, x19\n"
+    "    mov  x29, #0\n"
+    "    bl   psx_fiber_run_entry\n"
+    "    brk  #0\n"
+    ".size psx_fiber_ctx_start, .-psx_fiber_ctx_start\n");
+#else /* __x86_64__ (the Android emulator) */
+/* Frame: mxcsr + x87 control word, r15, r14, r13, r12, rbx, rbp, return
+ * address = 8 slots, 64 bytes. */
+#define PSX_FIBER_FRAME_BYTES 64
+#define PSX_FIBER_ARG_SLOT    5    /* rbx carries the fiber into ctx_start */
+#define PSX_FIBER_FP_SLOT     6    /* rbp */
+#define PSX_FIBER_RET_SLOT    7
+__asm__(
+    ".text\n"
+    ".p2align 4\n"
+    ".global psx_fiber_ctx_switch\n"
+    ".hidden psx_fiber_ctx_switch\n"
+    ".type psx_fiber_ctx_switch, @function\n"
+    "psx_fiber_ctx_switch:\n"
+    "    pushq %rbp\n"
+    "    pushq %rbx\n"
+    "    pushq %r12\n"
+    "    pushq %r13\n"
+    "    pushq %r14\n"
+    "    pushq %r15\n"
+    "    subq  $8, %rsp\n"
+    "    stmxcsr (%rsp)\n"
+    "    fnstcw 4(%rsp)\n"
+    "    movq  %rsp, (%rdi)\n"
+    "    movq  %rsi, %rsp\n"
+    "    ldmxcsr (%rsp)\n"
+    "    fldcw 4(%rsp)\n"
+    "    addq  $8, %rsp\n"
+    "    popq  %r15\n"
+    "    popq  %r14\n"
+    "    popq  %r13\n"
+    "    popq  %r12\n"
+    "    popq  %rbx\n"
+    "    popq  %rbp\n"
+    "    ret\n"
+    ".size psx_fiber_ctx_switch, .-psx_fiber_ctx_switch\n"
+    ".p2align 4\n"
+    ".global psx_fiber_ctx_start\n"
+    ".hidden psx_fiber_ctx_start\n"
+    ".type psx_fiber_ctx_start, @function\n"
+    "psx_fiber_ctx_start:\n"
+    "    movq  %rbx, %rdi\n"
+    "    xorl  %ebp, %ebp\n"
+    "    call  psx_fiber_run_entry\n"
+    "    ud2\n"
+    ".size psx_fiber_ctx_start, .-psx_fiber_ctx_start\n");
+#endif
+
+psx_fiber_t psx_fiber_convert_thread(void)
+{
+    if (!s_current) {
+        psx_fiber_impl* f = (psx_fiber_impl*)calloc(1, sizeof(*f));
+        if (!f) return NULL;
+        f->stack = NULL;       /* runs on the real thread stack */
+        s_current = f;
+    }
+    return (psx_fiber_t)s_current;
+}
+
+psx_fiber_t psx_fiber_current(void) { return (psx_fiber_t)s_current; }
+
+psx_fiber_t psx_fiber_create(size_t stack_size, psx_fiber_entry entry, void* arg)
+{
+    if (stack_size < 64u * 1024u) stack_size = 64u * 1024u;
+    psx_fiber_impl* f = (psx_fiber_impl*)calloc(1, sizeof(*f));
+    if (!f) return NULL;
+    f->stack = malloc(stack_size);
+    if (!f->stack) { free(f); return NULL; }
+    f->entry = entry;
+    f->arg   = arg;
+
+    /* Build the frame psx_fiber_ctx_switch pops, so the first switch here
+     * "returns" into psx_fiber_ctx_start with the fiber in a callee-saved
+     * register and a 16-byte aligned stack. */
+    uintptr_t top = ((uintptr_t)f->stack + stack_size) & ~(uintptr_t)15;
+    uint64_t* frame = (uint64_t*)(top - PSX_FIBER_FRAME_BYTES);
+    memset(frame, 0, PSX_FIBER_FRAME_BYTES);
+#if defined(__x86_64__)
+    frame[0] = 0x1F80u | ((uint64_t)0x037Fu << 32);  /* default mxcsr / x87 cw */
+#endif
+    frame[PSX_FIBER_ARG_SLOT] = (uint64_t)(uintptr_t)f;
+    frame[PSX_FIBER_FP_SLOT]  = 0;
+    frame[PSX_FIBER_RET_SLOT] = (uint64_t)(uintptr_t)&psx_fiber_ctx_start;
+    f->sp = frame;
+    return (psx_fiber_t)f;
+}
+
+void psx_fiber_switch(psx_fiber_t target)
+{
+    psx_fiber_impl* to   = (psx_fiber_impl*)target;
+    psx_fiber_impl* from = s_current;
+    if (!to || to == from) return;
+    s_current = to;
+    psx_fiber_ctx_switch(&from->sp, to->sp);
+    /* Resumed: s_current was set back to `from` by whoever switched here. */
+}
+
+void psx_fiber_destroy(psx_fiber_t fiber)
+{
+    psx_fiber_impl* f = (psx_fiber_impl*)fiber;
+    if (!f) return;
+    free(f->stack);
+    free(f);
+}
+
 #else /* POSIX: ucontext */
 
