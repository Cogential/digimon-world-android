diff --git a/runtime/src/psx_translate.cpp b/runtime/src/psx_translate.cpp
new file mode 100644
index 0000000..268ab4a
--- /dev/null
+++ b/runtime/src/psx_translate.cpp
@@ -0,0 +1,193 @@
+/*
+ * psx_translate.cpp — translate the player's own disc into C, in-process.
+ *
+ * The PSX_DYNAMIC_GAME counterpart of `psxrecomp_cli.py generate`: pull the
+ * boot executable off the disc image, check it is the build this port was
+ * made for, and run psxrecomp-game's pipeline (linked into this binary with
+ * its entry point renamed psxrecomp_game_main) to write generated/*.c, which
+ * psx_dynamic_game_load() then compiles at every launch.
+ */
+#include "psx_translate.h"
+
+#include "iso_reader.h"
+
+extern "C" {
+#include "psx_sha256.h"
+}
+#include "overlay_codegen_hash.h"
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <vector>
+
+#include <unistd.h>
+
+/* psxrecomp-game's main(), renamed at compile time (runtime.cmake). */
+int psxrecomp_game_main(int argc, char** argv);
+
+namespace {
+
+/* Changes whenever the recompiler's code generation does, so an app update
+ * with a newer recompiler re-translates instead of loading stale C. */
+std::string translate_version() {
+    char buf[32];
+    snprintf(buf, sizeof(buf), "cg-%08x", (unsigned)PSX_OVERLAY_CODEGEN_HASH);
+    return buf;
+}
+
+void set_err(char* err, size_t len, const char* fmt, ...) {
+    if (!err || !len) return;
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(err, len, fmt, ap);
+    va_end(ap);
+}
+
+std::string to_hex(const uint8_t* d, size_t n) {
+    static const char* k = "0123456789abcdef";
+    std::string s;
+    for (size_t i = 0; i < n; i++) { s += k[d[i] >> 4]; s += k[d[i] & 15]; }
+    return s;
+}
+
+/* The files besides the disc that decide what the recompiler writes: its
+ * configuration (game.toml: seeds, the functions mods hook, ...), the function
+ * seeds and the BIOS profile. An app update that changes any of them must
+ * re-translate, just as a new recompiler does. */
+std::string inputs_digest(const std::filesystem::path& root) {
+    static const char* const k_inputs[] = {
+        "game.toml", "seeds/ghidra_funcs.txt", "bios/SCPH1001.toml" };
+    psx_sha256_ctx ctx;
+    psx_sha256_init(&ctx);
+    for (const char* rel : k_inputs) {
+        std::ifstream f(root / rel, std::ios::binary);
+        const std::string data((std::istreambuf_iterator<char>(f)),
+                               std::istreambuf_iterator<char>());
+        psx_sha256_update(&ctx, (const uint8_t*)rel, std::strlen(rel) + 1);
+        psx_sha256_update(&ctx, (const uint8_t*)data.data(), data.size());
+    }
+    uint8_t digest[32];
+    psx_sha256_final(&ctx, digest);
+    return "in-" + to_hex(digest, 8);
+}
+
+bool read_disc_file(PS1::ISOReader& iso, const std::string& name,
+                    std::vector<uint8_t>& out) {
+    PS1::ISOFileEntry e;
+    if (!iso.FindFile(name, e) || e.is_directory) return false;
+    out.assign(e.size, 0);
+    uint8_t sector[2048];
+    for (uint32_t off = 0, lba = e.lba; off < e.size; off += 2048, lba++) {
+        if (!iso.ReadSector(lba, sector)) return false;
+        const uint32_t n = (e.size - off) < 2048 ? (e.size - off) : 2048;
+        std::memcpy(out.data() + off, sector, n);
+    }
+    return true;
+}
+
+/* BOOT = cdrom:\SLUS_010.32;1  ->  SLUS_010.32 */
+std::string boot_exe_from_system_cnf(const std::vector<uint8_t>& cnf) {
+    const std::string text(cnf.begin(), cnf.end());
+    size_t p = text.find("BOOT");
+    if (p == std::string::npos) return {};
+    p = text.find_first_of(":\\", p);
+    if (p == std::string::npos) return {};
+    while (p < text.size() && (text[p] == ':' || text[p] == '\\')) p++;
+    size_t end = text.find_first_of(";\r\n \t", p);
+    return text.substr(p, end == std::string::npos ? std::string::npos : end - p);
+}
+
+bool write_file(const std::filesystem::path& p, const void* data, size_t n) {
+    std::filesystem::create_directories(p.parent_path());
+    std::ofstream f(p, std::ios::binary | std::ios::trunc);
+    f.write(static_cast<const char*>(data), (std::streamsize)n);
+    return (bool)f;
+}
+
+}  // namespace
+
+extern "C" int psx_translate_disc(const char* data_dir, const char* disc_path,
+                                  const char* expect_exe_sha256,
+                                  char* err, size_t err_len) {
+    namespace fs = std::filesystem;
+    if (err && err_len) err[0] = '\0';
+
+    PS1::ISOReader iso;
+    if (!iso.Open(disc_path)) {
+        set_err(err, err_len, "Could not read the disc image (%s).", disc_path);
+        return -1;
+    }
+    std::vector<uint8_t> cnf, exe;
+    if (!read_disc_file(iso, "SYSTEM.CNF", cnf)) {
+        set_err(err, err_len, "This is not a PlayStation disc (no SYSTEM.CNF).");
+        return -1;
+    }
+    const std::string exe_name = boot_exe_from_system_cnf(cnf);
+    if (exe_name.empty() || !read_disc_file(iso, exe_name, exe)) {
+        set_err(err, err_len, "Could not find the game's program on the disc.");
+        return -1;
+    }
+    uint8_t digest[32];
+    psx_sha256_ctx ctx;
+    psx_sha256_init(&ctx);
+    psx_sha256_update(&ctx, exe.data(), exe.size());
+    psx_sha256_final(&ctx, digest);
+    const std::string exe_sha = to_hex(digest, sizeof(digest));
+    if (expect_exe_sha256 && expect_exe_sha256[0] && exe_sha != expect_exe_sha256) {
+        set_err(err, err_len,
+                "This disc's program (%s) is not the version this app supports.",
+                exe_name.c_str());
+        return -2;
+    }
+
+    const fs::path root(data_dir);
+    if (!write_file(root / "disc" / exe_name, exe.data(), exe.size()) ||
+        !write_file(root / "disc" / "SYSTEM.CNF", cnf.data(), cnf.size())) {
+        set_err(err, err_len, "Could not write to %s.", data_dir);
+        return -1;
+    }
+
+    /* psxrecomp-game resolves game.toml's relative paths (exe, seeds,
+     * out_dir) against the working directory. */
+    char old_cwd[4096];
+    if (!getcwd(old_cwd, sizeof(old_cwd))) old_cwd[0] = '\0';
+    if (chdir(data_dir) != 0) {
+        set_err(err, err_len, "Could not enter %s.", data_dir);
+        return -1;
+    }
+    std::error_code ec;
+    fs::remove(root / "generated" / ".translated", ec);
+    char a0[] = "psxrecomp-game", a1[] = "--config", a2[] = "game.toml";
+    char* argv[] = { a0, a1, a2, nullptr };
+    std::fflush(stdout);
+    const int rc = psxrecomp_game_main(3, argv);
+    std::fflush(stdout);
+    if (old_cwd[0]) (void)!chdir(old_cwd);
+    if (rc != 0) {
+        set_err(err, err_len, "The recompiler failed (code %d); see log.txt.", rc);
+        return -1;
+    }
+    /* Stamp what was translated, so a changed disc or a newer recompiler
+     * triggers a fresh translation (psx_translate_is_current). */
+    const std::string stamp = exe_sha + "\n" + translate_version() + "\n" +
+                              inputs_digest(root) + "\n";
+    write_file(root / "generated" / ".translated", stamp.data(), stamp.size());
+    return 0;
+}
+
+extern "C" int psx_translate_is_current(const char* data_dir,
+                                        const char* expect_exe_sha256) {
+    const std::filesystem::path root(data_dir);
+    std::ifstream f(root / "generated" / ".translated");
+    std::string sha, version, inputs;
+    if (!std::getline(f, sha) || !std::getline(f, version) || !std::getline(f, inputs))
+        return 0;
+    if (expect_exe_sha256 && expect_exe_sha256[0] && sha != expect_exe_sha256)
+        return 0;
+    return version == translate_version() && inputs == inputs_digest(root);
+}
